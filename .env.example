# Supabase Postgres — Transaction pooler URL (port 6543)
# Project Settings → Database → Connection string → Transaction pooler
POSTGRES_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Fathom OAuth app credentials
# Dev app: register redirect URI as http://localhost:3000/auth/callback
FATHOM_CLIENT_ID=
FATHOM_CLIENT_SECRET=

# AES-256-GCM key for encrypting tokens at rest (32 bytes, base64-encoded)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Base URL for OAuth redirect URIs
# Dev: http://localhost:3000
# Prod: https://your-app.vercel.app
APP_BASE_URL=http://localhost:3000
